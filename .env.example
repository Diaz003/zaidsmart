# ZAIDSMART - Configuración de Variables de Entorno
# Copia este archivo como .env y configura tus valores

# ==========================================
# API KEYS - Requeridas
# ==========================================

# OpenRouter API Key (Principal)
# Obtén tu clave gratuita en: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-tu-clave-aqui

# OpenAI API Key (Opcional - fallback)
# OPENAI_API_KEY=sk-tu-clave-aqui

# ==========================================
# SERVIDOR WEB
# ==========================================

# Host para el servidor web
WEB_HOST=0.0.0.0

# Puerto para el servidor web
WEB_PORT=8000

# ==========================================
# BASE DE DATOS
# ==========================================

# URL de conexión a la base de datos
DATABASE_URL=sqlite:///data/tasks.db

# ==========================================
# CONFIGURACIÓN DE IA
# ==========================================

# Modelos preferidos (separados por coma)
PREFERRED_MODELS=gpt-4o-mini,claude-3-haiku,gpt-3.5-turbo

# Timeout para requests de IA (segundos)
AI_TIMEOUT=30

# Máximo de reintentos por error de tasa
MAX_RETRIES=3

# ==========================================
# LOGGING
# ==========================================

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Archivo de logs
LOG_FILE=logs/zaidsmart.log

# ==========================================
# DESARROLLO
# ==========================================

# Modo debug
DEBUG=false

# Recargar automáticamente en desarrollo
AUTO_RELOAD=true
